generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CANDIDATE
  RECRUITER
  COMPANY_ADMIN
  PLATFORM_ADMIN
}

enum TestType {
  PERSONALITY
  EQ
  IQ
  LANGUAGE
  SKILL
}

enum QuestionType {
  LIKERT
  MCQ
  SITUATIONAL_JUDGEMENT
  WRITING
}

enum QuestionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETIRED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  MANUAL
  IMPORTED
  AI_GENERATED
  AI_TRANSLATED
}

enum ReviewVerdict {
  OK
  NEEDS_FIX
  REJECT
}

enum AiRunKind {
  GENERATE
  TRANSLATE
  GRADE
  FEEDBACK
  RECOMMEND
  SEARCH
}

enum AiRunStatus {
  COMPLETED
  FAILED
}

enum AuthTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
}

enum PlanFeatureKind {
  BOOLEAN
  LIMIT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentPurpose {
  SUBSCRIPTION
  COURSE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum JobOpeningStatus {
  OPEN
  PAUSED
  FILLED
  CLOSED
}

enum ShortlistStatus {
  SHORTLISTED
  CONTACTED
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
}

enum ContactRequestStatus {
  SENT
  ACCEPTED
  DECLINED
}

enum AtsExportStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationType {
  TOP_PERFORMER
  TEST_REMINDER
  SUBSCRIPTION_EXPIRING
  TRAINING_RECOMMENDATION
  TRAINING_UPDATE
  CONTACT_REQUEST
  GENERAL
}

enum BadgeType {
  TOP_PERFORMER_ALL_TESTS
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// ---------- Auth & users ----------

model User {
  id                 String            @id @default(cuid())
  integrityReviews   IntegrityReview[] @relation("IntegrityReviewer")
  email              String            @unique
  password           String
  role               Role              @default(CANDIDATE)
  name               String?
  emailVerified      DateTime?
  companyId          String?
  company            Company?          @relation(fields: [companyId], references: [id])
  isActive           Boolean           @default(true)
  mustChangePassword Boolean           @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  accounts   Account[]
  sessions   Session[]
  authTokens AuthToken[]

  candidateProfile CandidateProfile?

  shortlistsCreated   Shortlist[]      @relation("ShortlistRecruiter")
  contactRequestsSent ContactRequest[] @relation("ContactRequestRecruiter")
  jobOpeningsCreated  JobOpening[]     @relation("JobOpeningCreatedBy")
  apiKeysCreated      ApiKey[]         @relation("ApiKeyCreatedBy")
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([companyId])
}

/// Single-use, time-limited links sent by email. Only the SHA-256 hash of the token is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

/// One row per attempt, so rate limits survive restarts and work across several servers.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime

  @@index([key, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CandidateProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                String?
  city                 String?
  regionId             String?
  region               Region?   @relation(fields: [regionId], references: [id])
  experienceYears      Int?
  jobRoleId            String?
  jobRole              JobRole?  @relation(fields: [jobRoleId], references: [id])
  minimumSalary        Int?
  /// Optional. Used only to check the tests for fairness (never shown to recruiters or companies). Empty = prefer not to say.
  gender               Gender?
  consentGiven         Boolean   @default(false)
  consentAt            DateTime?
  privacyPolicyVersion String?
  /// Set when the candidate deletes their account: personal data is erased, test statistics stay.
  anonymisedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  testSessions          TestSession[]
  scores                Score[]
  aiFeedback            AIFeedback[]
  badges                Badge[]
  enrollments           Enrollment[]
  shortlistedIn         Shortlist[]
  contactRequests       ContactRequest[]
  atsExports            AtsExport[]
  courseRecommendations CourseRecommendation[]

  @@index([regionId])
  @@index([jobRoleId])
}

// ---------- Companies, plans, subscriptions ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  city      String?
  pilotMode Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  subscriptions     Subscription[]
  jobOpenings       JobOpening[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  pilotConfig       PilotConfig?
  payments          Payment[]
  mockAtsCandidates MockAtsCandidate[]
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  /// Feature values keyed by PlanFeature.key: true/false for BOOLEAN, a number (or null = unlimited) for LIMIT.
  features     Json
  priceMonthly Int
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
  payments      Payment[]
}

/// What a plan can switch on or off. Code checks read these keys, never the plan name.
model PlanFeature {
  key         String          @id
  label       String
  description String?
  kind        PlanFeatureKind
  sortOrder   Int             @default(0)
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id])
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(TRIALING)
  startDate DateTime           @default(now())
  endDate   DateTime?
  autoRenew Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  payments Payment[]

  @@index([companyId])
}

model Payment {
  id                String         @id @default(cuid())
  purpose           PaymentPurpose
  subscriptionId    String?
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id])
  enrollmentId      String?
  enrollment        Enrollment?    @relation(fields: [enrollmentId], references: [id])
  /// For a COURSE payment: what was bought and who paid (set even when the payment failed).
  courseId          String?
  course            Course?        @relation(fields: [courseId], references: [id])
  userId            String?
  /// For a SUBSCRIPTION payment: which company paid for which plan (set even when the payment failed).
  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id])
  planId            String?
  plan              Plan?          @relation(fields: [planId], references: [id])
  amount            Int
  currency          String
  status            PaymentStatus  @default(PENDING)
  provider          String
  providerReference String?
  createdAt         DateTime       @default(now())

  @@index([subscriptionId])
  @@index([enrollmentId])
  @@index([courseId])
  @@index([companyId])
}

// ---------- Reference data ----------

model JobRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  candidateProfiles CandidateProfile[]
  questions         Question[]
  courses           Course[]
  jobOpenings       JobOpening[]
  salaryBenchmarks  SalaryBenchmark[]
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cities City[]

  candidateProfiles CandidateProfile[]
  questions         Question[]
  regionLanguages   RegionLanguage[]
}

model Language {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  isRtl     Boolean  @default(false)
  createdAt DateTime @default(now())

  questions       Question[]
  regionLanguages RegionLanguage[]
}

model City {
  id        String   @id @default(cuid())
  name      String
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([regionId, name])
}

model ExperienceBand {
  id        String @id @default(cuid())
  label     String @unique
  minYears  Int
  maxYears  Int?
  sortOrder Int    @default(0)

  salaryBenchmarks SalaryBenchmark[]
}

model RegionLanguage {
  id         String   @id @default(cuid())
  regionId   String
  region     Region   @relation(fields: [regionId], references: [id])
  languageId String
  language   Language @relation(fields: [languageId], references: [id])
  isPrimary  Boolean  @default(true)

  @@unique([regionId, languageId])
}

// ---------- Question bank & self-learning ----------

model Question {
  id                 String         @id @default(cuid())
  testType           TestType
  type               QuestionType
  content            String
  options            Json?
  correctAnswer      String?
  reverseKeyed       Boolean        @default(false)
  difficulty         Difficulty     @default(MEDIUM)
  explanation        String?        @db.Text
  reviewNotes        String?        @db.Text
  reviewVerdict      ReviewVerdict?
  rejectionReason    String?
  source             QuestionSource @default(MANUAL)
  aiRunId            String?
  aiRun              AiRun?         @relation(fields: [aiRunId], references: [id])
  translationOfId    String?
  translationOf      Question?      @relation("QuestionTranslation", fields: [translationOfId], references: [id])
  translations       Question[]     @relation("QuestionTranslation")
  /// The earlier version this question replaces. Once a question has candidate responses its wording and
  /// answers are frozen; a change is made by retiring it and adding a new version that points back here.
  previousVersionId  String?
  previousVersion    Question?      @relation("QuestionVersion", fields: [previousVersionId], references: [id])
  nextVersions       Question[]     @relation("QuestionVersion")
  /// Set on a translation when its English original was replaced by a new version: the wording may no
  /// longer match, so it is listed in Approvals until a fresh translation is approved (or it is retired).
  needsRetranslation Boolean        @default(false)
  topic              String?
  jobRoleId          String?
  jobRole            JobRole?       @relation(fields: [jobRoleId], references: [id])
  regionId           String?
  region             Region?        @relation(fields: [regionId], references: [id])
  languageId         String?
  language           Language?      @relation(fields: [languageId], references: [id])
  aParam             Float
  bParam             Float
  status             QuestionStatus @default(DRAFT)
  isPretest          Boolean        @default(false)
  createdById        String?
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  itemStatistic ItemStatistic?
  responses     Response[]

  @@index([testType, status])
  @@index([jobRoleId])
  @@index([previousVersionId])
}

/// One AI batch (generate + review, or translate + review). Audit-logged as well.
model AiRun {
  id           String      @id @default(cuid())
  kind         AiRunKind
  actorId      String?
  model        String
  reviewModel  String
  testType     TestType?
  languageId   String?
  jobRoleId    String?
  difficulty   Difficulty?
  requested    Int
  created      Int         @default(0)
  dropped      Int         @default(0)
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  costEstimate Float       @default(0)
  status       AiRunStatus @default(COMPLETED)
  error        String?
  createdAt    DateTime    @default(now())

  questions Question[]

  @@index([createdAt])
}

model ItemStatistic {
  id               String    @id @default(cuid())
  questionId       String    @unique
  question         Question  @relation(fields: [questionId], references: [id])
  responseCount    Int       @default(0)
  correctCount     Int       @default(0)
  discrimination   Float?
  difficulty       Float?
  difByGender      Float?
  difByRegion      Float?
  difByLanguage    Float?
  flagged          Boolean   @default(false)
  flagReason       String?
  reviewedById     String?
  reviewedAt       DateTime?
  /// How many answers the item had when an admin last reviewed it; it is only flagged again after enough new answers.
  reviewedAtCount  Int?
  lastCalibratedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

model RecalibrationRun {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  itemsUpdated Int       @default(0)
  itemsChecked Int       @default(0)
  itemsFlagged Int       @default(0)
  triggeredBy  String
  status       String    @default("RUNNING")
  error        String?
}

/// One run of a scheduled job (recalibration, reminders, plan warnings, webhook retries, fairness report).
model JobRun {
  id          String    @id @default(cuid())
  job         String
  trigger     String
  status      String    @default("RUNNING")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  summary     Json?
  error       String?

  @@index([job, startedAt])
}

/// The monthly fairness report: how candidates of each group do on the tests. One per month.
model FairnessReport {
  id          String   @id @default(cuid())
  /// "2026-09"
  month       String   @unique
  generatedAt DateTime @default(now())
  generatedBy String?
  data        Json
}

/// The built-in mock ATS: a candidate pushed from a shortlist lands here, like it would in a customer's real ATS.
model MockAtsCandidate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  /// Our reference for the shortlist entry the candidate was pushed from.
  externalRef String
  externalId  String   @unique
  payload     Json
  receivedAt  DateTime @default(now())

  @@index([companyId])
}

model TestConfig {
  id                String   @id @default(cuid())
  testType          TestType @unique
  minItems          Int
  maxItems          Int
  seThreshold       Float
  timeLimitMinutes  Int
  retakeWaitingDays Int
  pretestItemCount  Int
  updatedAt         DateTime @updatedAt
}

// ---------- Test engine ----------

model TestSession {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  testType           TestType
  languageId         String?
  status             SessionStatus    @default(IN_PROGRESS)
  theta              Float            @default(0)
  standardError      Float?
  itemsAdministered  Int              @default(0)
  resumeState        Json?
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  expiresAt          DateTime?

  responses         Response[]
  score             Score?
  writingAssessment WritingAssessment?
  integrityReview   IntegrityReview?

  @@index([candidateProfileId, testType])
}

enum IntegrityDecision {
  CLEARED
  VOIDED
}

/// An admin's decision on a flagged test session (too many window exits). No row means "waiting for review".
model IntegrityReview {
  id           String            @id @default(cuid())
  sessionId    String            @unique
  session      TestSession       @relation(fields: [sessionId], references: [id])
  decision     IntegrityDecision
  reviewedById String
  reviewedBy   User              @relation("IntegrityReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime          @default(now())

  @@index([decision])
}

model Response {
  id             String      @id @default(cuid())
  sessionId      String
  session        TestSession @relation(fields: [sessionId], references: [id])
  questionId     String
  question       Question    @relation(fields: [questionId], references: [id])
  answerGiven    Json
  isCorrect      Boolean?
  /// false for unscored pretest items that are only collected for calibration
  isScored       Boolean     @default(true)
  responseTimeMs Int?
  thetaBefore    Float?
  thetaAfter     Float?
  answeredAt     DateTime    @default(now())

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
}

model WritingAssessment {
  id          String      @id @default(cuid())
  sessionId   String      @unique
  session     TestSession @relation(fields: [sessionId], references: [id])
  essayText   String
  cefrLevel   CefrLevel?
  rubricScore Json?
  feedback    String?
  gradedAt    DateTime?
}

// ---------- Scoring & candidate results ----------

model Score {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  sessionId          String           @unique
  session            TestSession      @relation(fields: [sessionId], references: [id])
  testType           TestType
  rawScore           Float
  percentile         Float?
  quartile           Int?
  cefrLevel          CefrLevel?
  /// Ability estimate (IRT) for adaptive tests; for Language it is the composite with the writing grade.
  theta              Float?
  standardError      Float?
  /// The number percentile and quartile are ranked on (theta, or the 0-100 EQ score). Null for Personality.
  rankValue          Float?
  /// Trait scores for Personality, accuracy and writing breakdown for others.
  details            Json?
  /// What the percentile was measured against: the candidate's job role or all candidates.
  cohortScope        String?
  cohortSize         Int?
  /// True while the writing task is still waiting to be graded.
  provisional        Boolean          @default(false)
  computedAt         DateTime         @default(now())
  /// Set when an admin voids the result after an integrity review; every reader of results skips it.
  voidedAt           DateTime?

  aiFeedback AIFeedback?

  @@index([candidateProfileId, testType])
}

model AIFeedback {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  testType           TestType
  /// The result this feedback is about; a retake gets its own feedback.
  scoreId            String?          @unique
  score              Score?           @relation(fields: [scoreId], references: [id], onDelete: SetNull)
  feedbackText       String
  improvementTips    Json?
  model              String?
  generatedAt        DateTime         @default(now())

  @@index([candidateProfileId, testType])
}

model Badge {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  type               BadgeType
  awardedAt          DateTime         @default(now())
  notifiedAt         DateTime?

  @@unique([candidateProfileId, type])
  @@index([candidateProfileId])
}

// ---------- Salary guide ----------

model SalaryBenchmark {
  id               String         @id @default(cuid())
  jobRoleId        String
  jobRole          JobRole        @relation(fields: [jobRoleId], references: [id])
  city             String
  experienceBandId String
  experienceBand   ExperienceBand @relation(fields: [experienceBandId], references: [id])
  minSalary        Int
  avgSalary        Int
  maxSalary        Int
  updatedAt        DateTime       @updatedAt

  @@unique([jobRoleId, city, experienceBandId])
}

// ---------- Training ----------

model Course {
  id          String    @id @default(cuid())
  title       String
  description String?
  isFree      Boolean   @default(true)
  price       Int       @default(0)
  jobRoleId   String?
  jobRole     JobRole?  @relation(fields: [jobRoleId], references: [id])
  /// The assessment this course helps with (null = general). Used for recommendations and for retaking after training.
  testType    TestType?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lessons         CourseLesson[]
  enrollments     Enrollment[]
  payments        Payment[]
  recommendations CourseRecommendation[]
}

model CourseLesson {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  title           String
  content         String?
  order           Int
  durationMinutes Int?
  createdAt       DateTime @default(now())

  lessonProgress LessonProgress[]

  @@index([courseId])
}

model Enrollment {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  courseId           String
  course             Course           @relation(fields: [courseId], references: [id])
  status             EnrollmentStatus @default(NOT_STARTED)
  progressPercent    Int              @default(0)
  enrolledAt         DateTime         @default(now())
  completedAt        DateTime?

  lessonProgress LessonProgress[]
  payments       Payment[]

  @@unique([candidateProfileId, courseId])
}

model LessonProgress {
  id           String       @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id])
  lessonId     String
  lesson       CourseLesson @relation(fields: [lessonId], references: [id])
  completedAt  DateTime?

  @@unique([enrollmentId, lessonId])
}

/// A course suggested to a candidate from their weak areas (by AI, or by simple rules when AI is unavailable).
model CourseRecommendation {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reason             String
  /// AI or RULES
  source             String
  createdAt          DateTime         @default(now())

  @@unique([candidateProfileId, courseId])
  @@index([candidateProfileId])
}

// ---------- Recruiter tools & job openings ----------

model JobOpening {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  jobRoleId      String
  jobRole        JobRole          @relation(fields: [jobRoleId], references: [id])
  /// A short name for the opening, for example "Senior accountant". Optional.
  title          String?
  city           String?
  salaryRangeMin Int
  salaryRangeMax Int
  status         JobOpeningStatus @default(OPEN)
  createdById    String
  createdBy      User             @relation("JobOpeningCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  shortlists      Shortlist[]
  contactRequests ContactRequest[]

  @@index([companyId])
  @@index([jobRoleId])
}

model Shortlist {
  id                 String           @id @default(cuid())
  recruiterId        String
  recruiter          User             @relation("ShortlistRecruiter", fields: [recruiterId], references: [id])
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  jobOpeningId       String
  jobOpening         JobOpening       @relation(fields: [jobOpeningId], references: [id])
  status             ShortlistStatus  @default(SHORTLISTED)
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  statusHistory ShortlistStatusHistory[]

  @@unique([recruiterId, candidateProfileId, jobOpeningId])
  @@index([candidateProfileId])
  @@index([jobOpeningId])
}

model ShortlistStatusHistory {
  id          String          @id @default(cuid())
  shortlistId String
  shortlist   Shortlist       @relation(fields: [shortlistId], references: [id])
  status      ShortlistStatus
  changedAt   DateTime        @default(now())
  changedById String?

  @@index([shortlistId])
}

model ContactRequest {
  id                 String               @id @default(cuid())
  recruiterId        String
  recruiter          User                 @relation("ContactRequestRecruiter", fields: [recruiterId], references: [id])
  candidateProfileId String
  candidateProfile   CandidateProfile     @relation(fields: [candidateProfileId], references: [id])
  jobOpeningId       String
  jobOpening         JobOpening           @relation(fields: [jobOpeningId], references: [id])
  status             ContactRequestStatus @default(SENT)
  message            String?
  sentAt             DateTime             @default(now())
  respondedAt        DateTime?

  @@index([candidateProfileId])
  @@index([jobOpeningId])
}

// ---------- ATS integration ----------

model AtsExport {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  companyId          String
  status             AtsExportStatus  @default(PENDING)
  payload            Json
  externalId         String?
  exportedAt         DateTime         @default(now())

  @@index([candidateProfileId])
  @@index([companyId])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([companyId])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id])
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempt        Int                   @default(1)
  respondedAt    DateTime?
  /// The HTTP status the receiving server answered with, or the reason it failed.
  responseStatus Int?
  error          String?
  /// When an automatic retry is due (null when no retry is planned).
  nextAttemptAt  DateTime?
  createdAt      DateTime              @default(now())

  @@index([endpointId])
  @@index([status, nextAttemptAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  label       String?
  hashedKey   String    @unique
  /// The first characters of the key, so a company can tell its keys apart. The key itself is never stored.
  prefix      String?
  createdById String
  createdBy   User      @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
}

// ---------- Platform configuration ----------

model PilotConfig {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false)
  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id])
  updatedAt DateTime @updatedAt
}

/// One row per settings group (branding, homepage, currency, quartiles, ...). Shape is validated in code.
model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Versioned legal text. The newest current row is shown; each candidate's consent records its version.
model PolicyDocument {
  id          String   @id @default(cuid())
  kind        String
  version     String
  title       String
  body        String   @db.Text
  isCurrent   Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdById String?

  @@unique([kind, version])
}

/// Email / in-app message wording. Keys are fixed (they match a trigger); the wording is editable.
model MessageTemplate {
  key         String              @id
  name        String
  description String?
  channel     NotificationChannel
  subject     String
  body        String              @db.Text
  variables   Json
  isActive    Boolean             @default(true)
  updatedAt   DateTime            @updatedAt
}

// ---------- Notifications & audit ----------

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  /// Page to open when the notification is clicked (a path inside the app).
  link      String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}

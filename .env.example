# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Docker Postgres, host port 55432 per CLAUDE.md) ---
DATABASE_URL="postgresql://workforce:workforce@localhost:55432/workforce_pro"

# --- Auth.js ---
# Generate with: npx auth secret
# No NEXTAUTH_URL/AUTH_URL: trustHost:true in auth.config.ts lets Auth.js infer
# the host per-request, which is what lets both the dev server (7310) and the
# Playwright test server (7330) work without hardcoding one or the other.
AUTH_SECRET=""

# --- Claude API ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# --- SMTP (Brevo). If unset, emails are logged to console instead of sent. ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Workforce Pro <no-reply@example.com>"

# --- Demo mode (payments, ATS, salary data run in simulated/test mode) ---
DEMO_MODE="true"

# --- Seed: platform admin account (created only by `npm run prisma:seed`) ---
SEED_ADMIN_EMAIL="admin@workforcepro.test"
SEED_ADMIN_PASSWORD=""

# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Docker Postgres, host port 55432 per CLAUDE.md) ---
DATABASE_URL="postgresql://workforce:workforce@localhost:55432/workforce_pro"

# --- Auth.js ---
# Generate with: npx auth secret
# No NEXTAUTH_URL/AUTH_URL: trustHost:true in auth.config.ts lets Auth.js infer
# the host per-request, which is what lets both the dev server (7310) and the
# Playwright test server (7330) work without hardcoding one or the other.
AUTH_SECRET=""

# --- Claude API ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# --- SMTP (Brevo). If unset, emails are logged to console instead of sent. ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Workforce Pro <no-reply@example.com>"

# --- Public address of the app, used in emailed links (password reset, email confirmation). ---
# Always set this in production. It is never taken from the request, so a forged Host header cannot
# redirect a reset link. Defaults to http://localhost:7310 when unset (development only).
APP_BASE_URL="http://localhost:7310"

# --- Scheduled jobs (recalibration, test reminders, plan warnings, webhook retries, fairness report) ---
# JOBS_AUTORUN=true starts the built-in scheduler when the server starts (development and a single server).
# Leave it out (or false) when another tool starts the app, such as the tests. JOBS_TICK_SECONDS is how often it looks (default 300).
JOBS_AUTORUN="true"
# For an outside scheduler: POST /api/jobs/run with "Authorization: Bearer <this value>". At least 16 characters;
# without it the endpoint is switched off. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""

# --- Demo mode (payments, ATS, salary data run in simulated/test mode) ---
DEMO_MODE="true"

# --- Seed: platform admin account (created only by `npm run prisma:seed`) ---
SEED_ADMIN_EMAIL="admin@workforcepro.test"
SEED_ADMIN_PASSWORD=""

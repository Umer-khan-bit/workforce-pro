{
  "name": "workforce-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7310",
    "build": "next build",
    "start": "next start -p 7310",
    "start:test": "next start -p 7330",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio --port 7320",
    "prisma:seed": "tsx prisma/seed.ts",
    "shuffle:scan": "tsx --env-file=.env scripts/scanShuffleQuestions.ts",
    "load:check": "tsx --env-file=.env scripts/loadCheck.ts",
    "demo:reset": "tsx --env-file=.env prisma/resetDemoStory.ts",
    "content:approve": "tsx --env-file=.env prisma/approveDemoContent.ts",
    "content:demo": "tsx --env-file=.env prisma/generateDemoContent.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "next": "16.3.7",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
